<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="18dp"
    android:layout_marginBottom="14dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvItemService"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Cleaning Service"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/tvItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Assigned"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:background="#DBEAFE"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvItemClient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Client: Name"
        android:textSize="13sp"
        android:textColor="#475569"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvItemDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="📅 Date &amp; Time"
        android:textSize="12sp"
        android:textColor="#94A3B8"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnItemDetails"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Details"
            android:textColor="#0F172A"
            android:backgroundTint="#F1F5F9"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnItemUpdateStatus"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Update Status"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>