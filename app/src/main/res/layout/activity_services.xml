<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Our Cleaning Services"
            android:textColor="@color/brand_royal_blue"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a service to book your cleaning session."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Couch Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_horizontal">

            <!-- Circular Image for Couch -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgCouch"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_couch"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Couch Cleaning"
                    android:textColor="@color/brand_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="R 450.00"
                    android:textColor="@color/brand_royal_blue"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deep fabric washing, stain removal, and odor elimination."
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginVertical="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCouch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Book Couch Cleaning"
                android:textColor="@color/white"
                android:backgroundTint="@color/brand_royal_blue"
                app:icon="@drawable/ic_cleaning"
                app:iconTint="@color/white" />
        </LinearLayout>

        <!-- Sneaker Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_horizontal">

            <!-- Circular Image for Sneakers -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgSneakers"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_sneakers"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sneaker Cleaning"
                    android:textColor="@color/brand_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="R 150.00"
                    android:textColor="@color/brand_royal_blue"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Premium footwear care: soles, uppers, and lace detailing."
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginVertical="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSneakers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Book Sneaker Cleaning"
                android:textColor="@color/white"
                android:backgroundTint="@color/brand_royal_blue"
                app:icon="@drawable/ic_cleaning"
                app:iconTint="@color/white" />
        </LinearLayout>

        <!-- Carpet Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginBottom="24dp"
            android:gravity="center_horizontal">

            <!-- Circular Image for Carpet -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgCarpet"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_carpet"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carpet Cleaning"
                    android:textColor="@color/brand_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="R 350.00"
                    android:textColor="@color/brand_royal_blue"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="High-pressure carpet steaming and deep fiber extraction."
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginVertical="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCarpet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Book Carpet Cleaning"
                android:textColor="@color/white"
                android:backgroundTint="@color/brand_royal_blue"
                app:icon="@drawable/ic_cleaning"
                app:iconTint="@color/white" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>