<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/brand_royal_blue"
            android:padding="28dp">

            <TextView
                android:id="@+id/tvSettingsInitials"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/bg_rounded_input"
                android:backgroundTint="@color/brand_light_blue"
                android:gravity="center"
                android:text="--"
                android:textColor="@color/brand_royal_blue"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvSettingsProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading profile..."
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSettingsProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/brand_light_blue"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- App Theme Setting -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APP PREFERENCES"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/white"
                android:padding="16dp"
                android:elevation="1dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dark Mode Theme"
                    android:textColor="@color/brand_dark_slate"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDarkMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Personal Details Settings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT DETAILS"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FULL NAME"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etSettingsName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Full Name"
                android:padding="14dp"
                android:background="@drawable/bg_rounded_input"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHONE NUMBER"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etSettingsPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone Number"
                android:inputType="phone"
                android:padding="14dp"
                android:background="@drawable/bg_rounded_input"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update Account Info"
                android:textColor="@color/white"
                android:backgroundTint="@color/brand_royal_blue"
                android:padding="14dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Security Settings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURITY"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send Password Reset Email"
                style="?attr/materialButtonOutlinedStyle"
                app:strokeColor="@color/brand_royal_blue"
                android:textColor="@color/brand_royal_blue"
                android:padding="14dp"
                android:layout_marginBottom="24dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettingsLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Log Out"
                android:textColor="@color/brand_crimson_red"
                style="?attr/materialButtonOutlinedStyle"
                app:strokeColor="@color/brand_crimson_red"
                android:padding="14dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>

