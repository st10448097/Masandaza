<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Staff Green Header (From image_17.png) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/staff_green"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good morning ☀️"
                android:textColor="@color/staff_green_light"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvStaffNameHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staff Member"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginVertical="2dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvStaffIdBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: TM-001"
                    android:textColor="@color/staff_green"
                    android:background="@color/white"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 4.9 Rating"
                    android:textColor="@color/white"
                    android:background="#22FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 3 Live Counters (From image_17.png) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@color/white"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginEnd="4dp">
                    <TextView
                        android:id="@+id/tvCountToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/brand_royal_blue"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Jobs"
                        android:textColor="#64748B"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@color/white"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginHorizontal="4dp">
                    <TextView
                        android:id="@+id/tvCountPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#D97706"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:textColor="#64748B"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@color/white"
                    android:padding="14dp"
                    android:elevation="2dp"
                    android:layout_marginStart="4dp">
                    <TextView
                        android:id="@+id/tvCountCompleted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/staff_green"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Completed"
                        android:textColor="#64748B"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S SCHEDULE"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Container for Real Firestore Jobs -->
            <LinearLayout
                android:id="@+id/containerStaffSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnViewAllJobsNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View All Jobs Management"
                android:textColor="@color/white"
                android:backgroundTint="@color/staff_green"
                android:padding="14dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnStaffProfileNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Staff Profile &amp; Settings"
                style="?attr/materialButtonOutlinedStyle"
                app:strokeColor="@color/staff_green"
                android:textColor="@color/staff_green"
                android:padding="14dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>

