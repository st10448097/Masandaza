<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Deep Blue Header Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E3A8A"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track Booking"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-time progress of your active cleaning session"
                android:textColor="#93C5FD"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Active Booking Info Card (Live Data) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tvTrackBookingRef"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BOOKING REF: --"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:id="@+id/tvTrackCurrentStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#D97706"
                        android:background="#FEF3C7"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTrackServiceTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service: Loading..."
                    android:textSize="13sp"
                    android:textColor="#475569" />
            </LinearLayout>

            <!-- Status Timeline Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS TIMELINE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1E3A8A"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="16dp" />

                <!-- Step 1 -->
                <TextView
                    android:id="@+id/tvTimelineStep1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="○  1. Booking Received &amp; Logged"
                    android:textSize="14sp"
                    android:textColor="#94A3B8"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Step 2 -->
                <TextView
                    android:id="@+id/tvTimelineStep2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="○  2. Staff Member Assigned"
                    android:textSize="14sp"
                    android:textColor="#94A3B8"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Step 3 -->
                <TextView
                    android:id="@+id/tvTimelineStep3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="○  3. Cleaning In Progress"
                    android:textSize="14sp"
                    android:textColor="#94A3B8"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Step 4 -->
                <TextView
                    android:id="@+id/tvTimelineStep4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="○  4. Service Completed &amp; Reviewed"
                    android:textSize="14sp"
                    android:textColor="#94A3B8"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Support Action Button (Kept Functional) -->
            <Button
                android:id="@+id/btnCallStudioSupport"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📞 Call Studio Support"
                android:backgroundTint="#DC2626"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>