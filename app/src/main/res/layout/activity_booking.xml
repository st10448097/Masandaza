<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Bold Blue Header Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E3A8A"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book a Cleaning"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Professional cleaning scheduled to your door"
                android:textColor="#93C5FD"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Service Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECTED SERVICE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1E3A8A"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etBookingService"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="e.g. Deep Clean / Couch Cleaning"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="14dp" />

            <!-- Address Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVICE ADDRESS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1E3A8A"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etBookingAddress"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="Enter street address in Soweto / Gauteng"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="14dp" />

            <!-- Date & Time Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1E3A8A"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etBookingDate"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_rounded_input"
                        android:hint="YYYY-MM-DD"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:focusable="false"
                        android:clickable="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TIME"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1E3A8A"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etBookingTime"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_rounded_input"
                        android:hint="09:00 AM"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Additional Notes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADDITIONAL NOTES (OPTIONAL)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1E3A8A"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etBookingNotes"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="Any special instructions for the cleaning team..."
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:padding="14dp"
                android:gravity="top"
                android:layout_marginBottom="24dp" />

            <!-- Confirm & Pay Button in Deep Blue with Red Accent Touch -->
            <Button
                android:id="@+id/btnConfirmBooking"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Confirm &amp; Pay"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
