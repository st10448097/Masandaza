<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="18dp"
    android:elevation="2dp"
    android:layout_marginBottom="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvBookingServiceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Couch Deep Clean"
            android:textColor="@color/brand_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBookingStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Booked"
            android:textColor="@color/brand_royal_blue"
            android:background="@color/brand_light_blue"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvBookingReference"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#BK-2025-0042"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:layout_marginVertical="4dp"/>

    <TextView
        android:id="@+id/tvBookingDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2025-08-15 • 09:00 AM"
        android:textColor="#334155"
        android:textSize="13sp"
        android:layout_marginBottom="14dp"/>

    <Button
        android:id="@+id/btnTrackBooking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Track Progress"
        android:textColor="@color/white"
        android:backgroundTint="@color/brand_royal_blue"/>

</LinearLayout>
