<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Bold Red Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#DC2626"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update Job Status"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select new progress stage for this booking"
                android:textColor="#FEE2E2"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RadioGroup
                android:id="@+id/rgStatusOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rbStatusPending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColor="#0F172A"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/rbStatusAssigned"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Staff Assigned"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColor="#0F172A"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/rbStatusInProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cleaning In Progress"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColor="#0F172A"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/rbStatusReview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ready for Review"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColor="#0F172A"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/rbStatusCompleted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Completed"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColor="#0F172A"
                    android:background="#FFFFFF" />
            </RadioGroup>

            <!-- Save Button in Blue -->
            <Button
                android:id="@+id/btnSubmitStatusUpdate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Save New Status"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
