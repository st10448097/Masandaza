<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    android:backgroundTint="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvBookingServiceTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Deep Cleaning Service"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/brand_royal_blue" />

            <TextView
                android:id="@+id/tvBookingStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Booked"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_badge_rounded" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBookingReference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ref: BK-1234"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvBookingDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date: 2026-11-01 at 09:00 AM"
            android:textSize="13sp"
            android:textColor="#334155"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnTrackBooking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Details / Track"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/brand_royal_blue"
            style="?attr/materialButtonOutlinedStyle"
            app:strokeColor="@color/brand_royal_blue"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>