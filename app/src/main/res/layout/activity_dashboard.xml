<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Blue Header Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/brand_royal_blue"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good day 👋"
                android:textColor="@color/brand_light_blue"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading account..."
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginVertical="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masandaza Cleaning &amp; Carpets Studio"
                android:textColor="@color/brand_light_blue"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 4 Grid Action Cards (From image_9.png) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnNavBook"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Book\nCleaning"
                    android:textColor="@color/brand_royal_blue"
                    android:backgroundTint="@color/white"
                    app:strokeColor="@color/brand_royal_blue"
                    app:strokeWidth="1dp"/>

                <Button
                    android:id="@+id/btnNavMyBookings"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="My\nBookings"
                    android:textColor="@color/brand_royal_blue"
                    android:backgroundTint="@color/white"
                    app:strokeColor="@color/brand_royal_blue"
                    app:strokeWidth="1dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btnNavTrack"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Track\nBooking"
                    android:textColor="@color/brand_royal_blue"
                    android:backgroundTint="@color/white"
                    app:strokeColor="@color/brand_royal_blue"
                    app:strokeWidth="1dp"/>

                <Button
                    android:id="@+id/btnNavPayments"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Payments &amp;\nReceipts"
                    android:textColor="@color/brand_royal_blue"
                    android:backgroundTint="@color/white"
                    app:strokeColor="@color/brand_royal_blue"
                    app:strokeWidth="1dp"/>
            </LinearLayout>

            <!-- Next Appointment Active Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT APPOINTMENT"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/brand_royal_blue"
                android:padding="18dp"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvDashActiveTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Active Appointment"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvDashActiveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="None"
                        android:textColor="@color/white"
                        android:background="@color/brand_crimson_red"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvDashActiveDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap 'Book Cleaning' to schedule your session."
                    android:textColor="@color/brand_light_blue"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnDashSettingsNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings &amp; Profile"
                style="?attr/materialButtonOutlinedStyle"
                app:strokeColor="@color/brand_royal_blue"
                android:textColor="@color/brand_royal_blue"
                android:padding="12dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>