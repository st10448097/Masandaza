<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvBookingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Bookings"
            android:textColor="#1769AA"
            android:textSize="27sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvBookingsSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View your cleaning orders and their progress."
            android:textColor="#667085"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

        <!--booking section heading-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upcoming and Active Bookings"
            android:textColor="#172B4D"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:id="@+id/layoutBookingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/tvBookingService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Couch Cleaning"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#172B4D"/>

            <TextView
                android:id="@+id/tvBookingReference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Booking reference: sample booking"
                android:textColor="#667085"
                android:textSize="13sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvBookingDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date: To be confirmed"
                android:textColor="#344054"
                android:textSize="15sp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/tvBookingTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Time: To be confirmed"
                android:textColor="#344054"
                android:textSize="15sp"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/tvBookingsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Booked"
                android:textColor="#1769AA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"/>

            <Button
                android:id="@+id/btnViewTracking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Track Cleaning"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1769AA"
                android:layout_marginTop="16dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>