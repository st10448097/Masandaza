<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment"
            android:textColor="@color/brand_royal_blue"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/brand_dark_slate"
            android:padding="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booking ID"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tvPaymentBookingRef"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="#BK-2025-0000"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="15sp"/>
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#334155" android:layout_marginVertical="12dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount Due"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="15sp"/>
                <TextView
                    android:id="@+id/tvPaymentAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="R 0.00"
                    android:textColor="@color/brand_crimson_red"
                    android:textStyle="bold"
                    android:textSize="22sp"/>
            </RelativeLayout>
        </LinearLayout>


        <!-- REMOVED: Manual Card Inputs           -->
        <!-- PayFast can handle this securely, main reason for using API -->



        <!-- ADDED: PayFast WebView                  -->
        <!-- This acts as a mini-browser inside the app.-->
        <!-- It stays invisible (gone) until the -->
        <!-- user clicks "Pay Now". -->

        <WebView
            android:id="@+id/payfastWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSubmitPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pay Now"
            android:textColor="@color/white"
            android:backgroundTint="@color/brand_royal_blue"
            android:padding="14dp"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>