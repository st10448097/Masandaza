<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:gravity="center"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FFFFFF"
        android:padding="32dp"
        android:elevation="4dp">

        <!-- Success Checkmark Badge -->
        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_circle_avatar"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Successful!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your cleaning session has been confirmed and logged in the system."
            android:textSize="13sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Transaction Details Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F1F5F9"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURE TRANSACTION CONFIRMED"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:letterSpacing="0.06"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSuccessDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Verified &amp; Paid\nProcessed via Secure Gateway"
                android:textSize="13sp"
                android:textColor="#1E293B" />
        </LinearLayout>

        <!-- Back to Dashboard Button in Blue -->
        <Button
            android:id="@+id/btnBackToHome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Back to Dashboard"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>
